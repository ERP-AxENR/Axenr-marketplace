<?xml version="1.0" encoding="UTF-8"?>
<csv-inputs xmlns="http://axelor.com/xml/ns/data-import"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/data-import http://axelor.com/xml/ns/data-import/data-import_8.2.xsd">

  <!-- Geste après le premier démarrage (base recréée par un paquet data-init) : règle le prochain numéro
       de la séquence des tiers (TXXXX) pour qu'elle ne réémette jamais un numéro déjà porté par le paquet (mettre la valeur de la source).
       update="true" : met à jour la version en cours, n'en crée JAMAIS (ligne ignorée si elle manque :
       contrôler la valeur après coup). Rejouable : réécrit la même valeur. -->
  <input file="compteur-tiers.csv" separator=";" type="com.axelor.apps.base.db.SequenceVersion"
    search="self.sequence.codeSelect = 'partner' AND self.endDate IS NULL" update="true">
    <bind column="nextNum" to="nextNum"/>
  </input>

</csv-inputs>
